###
# Pins
###
# The pins of the Tentiva boards are those of the earlier Avant DP design
# (gateware/ref/lsc/lav_g70_versa_evn). Where the HDMI Avant design uses the same FMC pin
# for its own card, the pin agrees with it; the comments give that pin on the
# CertusPro-NX and the HDMI signal there.

# Bank VCCIO
ldc_set_vcc -bank 6 1.8
ldc_set_vcc -bank 9 1.8

# Clocks
ldc_set_location -site {T7} [get_ports SYS_CLK_IN]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports SYS_CLK_IN]
ldc_set_location -site {AP30} [get_ports TENTIVA_VID_CLK_IN]
ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports TENTIVA_VID_CLK_IN]

# PHY
# The FMC high speed lanes are connected to MPQ0
ldc_set_location -site {MPQ0_RX0P} [get_ports {DPRX_ML_IN_P[0]}]

# LED
ldc_set_location -site {AN10} [get_ports {LED_OUT[0]}]
ldc_set_location -site {AJ13} [get_ports {LED_OUT[1]}]
ldc_set_location -site {AH13} [get_ports {LED_OUT[2]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports {LED_OUT[0]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports {LED_OUT[1]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports {LED_OUT[2]}]

# Switch
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports SYS_RSTN_IN]
ldc_set_location -site {U3} [get_ports SYS_RSTN_IN]

# I2C
ldc_set_location -site {W4} [get_ports I2C_SCL_INOUT]
ldc_set_location -site {U7} [get_ports I2C_SDA_INOUT]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports I2C_SCL_INOUT]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports I2C_SDA_INOUT]

# UART
# Tentiva Rev. C/D
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports UART_TX_OUT]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports UART_RX_IN]
ldc_set_location -site {AJ32} [get_ports UART_TX_OUT]
ldc_set_location -site {AJ31} [get_ports UART_RX_IN]

# Tentiva DP2.1 RX
ldc_set_location -site {AL33} [get_ports DPRX_AUX_EN_OUT]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPRX_AUX_EN_OUT]
ldc_set_location -site {AL34} [get_ports DPRX_AUX_TX_OUT]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPRX_AUX_TX_OUT]
ldc_set_location -site {AK30} [get_ports DPRX_AUX_RX_IN]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPRX_AUX_RX_IN]
ldc_set_location -site {AK33} [get_ports DPRX_HPD_OUT]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPRX_HPD_OUT]
ldc_set_location -site {AK29} [get_ports DPRX_I2C_SEL_OUT]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPRX_I2C_SEL_OUT]
ldc_set_location -site {AK34} [get_ports DPRX_CABDET_IN]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPRX_CABDET_IN]

# Tentiva DP2.1 TX
ldc_set_location -site {AH34} [get_ports DPTX_AUX_EN_OUT]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPTX_AUX_EN_OUT]
ldc_set_location -site {AG32} [get_ports DPTX_AUX_TX_OUT]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPTX_AUX_TX_OUT]
ldc_set_location -site {AG34} [get_ports DPTX_AUX_RX_IN]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPTX_AUX_RX_IN]
ldc_set_location -site {AG28} [get_ports DPTX_HPD_IN]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPTX_HPD_IN]
ldc_set_location -site {AF32} [get_ports DPTX_I2C_SEL_OUT]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports DPTX_I2C_SEL_OUT]
