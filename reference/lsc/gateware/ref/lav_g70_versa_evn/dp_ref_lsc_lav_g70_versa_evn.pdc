###
# Timing
###
# Link clocks
# The link clock is the line rate divided by 40: four symbols per clock at every rate,
# because all PHY profiles use gearing 2. The fastest rate, 8.1 Gbps, gives 202.5 MHz,
# 1.5 times the 135 MHz reference; the design has to meet timing there.
# DPTX link clock
create_generated_clock -name {tx_lnk_clk} -source [get_pins {PHY_INST/lscc_mpphy_inst/mpp_nonpipe_x4_q0.u_Q0_nonpipe_x4.MPPHYX4A_MODE_inst/REFCLK_P}] -divide_by 2 -multiply_by 3 [get_pins {PHY_INST/lscc_mpphy_inst/mpp_nonpipe_x4_q0.u_Q0_nonpipe_x4.MPPHYX4A_MODE_inst/TXOUTGCLK_PLL0}]
# DPRX link clock
create_generated_clock -name {rx_lnk_clk} -source [get_pins {PHY_INST/lscc_mpphy_inst/mpp_nonpipe_x4_q0.u_Q0_nonpipe_x4.MPPHYX4A_MODE_inst/REFCLK_P}] -divide_by 2 -multiply_by 3 [get_pins {PHY_INST/lscc_mpphy_inst/mpp_nonpipe_x4_q0.u_Q0_nonpipe_x4.MPPHYX4A_MODE_inst/RXOUTGCLK_L0}]

set_clock_groups -group [get_clocks sys_clk] -group [get_clocks phy_ref_clk] -group [get_clocks clk_from_sys_pll] -group [get_clocks rx_lnk_clk] -group [get_clocks tx_lnk_clk] -group [get_clocks vid_clk] -asynchronous

###
# False path
###
# Reset synchronizers of the Lattice clock domain crossings (lscc_cdc_hs_bus)
# The first stage of each reset synchronizer runs on the falling clock edge and takes the
# reset of the other domain asynchronously, so it only gets half a clock period to reach
# it. That is an asynchronous reset into the first stage of a synchronizer, which the
# following stages take care of, so the path needs no timing. The constraint file that
# comes with lscc_cdc does not cover it. One synchronizer per direction per crossing; a
# crossing whose resets are tied off has no synchronizer left to constrain.
set_false_path -to [get_pins {DPRX_INST/DPRX_INST/LNK_INST/LNK_MSG_CDC_INST/FIFO_INST/gen_bclk_sta.WP_CDC_INST/gen_gray.CDC_INST/lscc_cdc.CDC_INST/u_lscc_sync_src_rst/genblk1.genblk2.genblk1.src_to_dest_rstn_cc/PD}]
set_false_path -to [get_pins {DPRX_INST/DPRX_INST/LNK_INST/LNK_MSG_CDC_INST/FIFO_INST/gen_bclk_sta.WP_CDC_INST/gen_gray.CDC_INST/lscc_cdc.CDC_INST/u_lscc_sync_dest_rst/genblk1.genblk2.genblk1.src_to_dest_rstn_cc/PD}]
