ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports UART_RX_IN]
ldc_set_location -site {W10} [get_ports UART_TX_OUT]
ldc_set_location -site {W11} [get_ports UART_RX_IN]

